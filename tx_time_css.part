
/* ============================================================================
   TIME ANALYSIS - redesigned frame  (.tx-*)

   The Time tab of the Test Analysis workspace is framed like the approved
   design: a badge/title header with the Test Date card and tagline, a four-card
   KPI row, an insight banner, and a two-column body (paginated per-question
   table | Time Distribution donuts + tip strip).

   Everything is driven by the --ta2-* theme tokens so the page follows the
   light/dark themes of the shell with no extra overrides.
   ========================================================================== */

.tx-page {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ------------------------------ header --------------------------------- */

.tx-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.tx-head__left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.tx-head__badge {
  width: 48px;
  height: 48px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 15px;
  color: #ffffff;
  background: linear-gradient(140deg, #5b8def 0%, #6d5cf6 55%, #a855f7 100%);
  box-shadow: 0 10px 22px rgba(97, 108, 246, 0.35);
}

.tx-head__badge svg { width: 24px; height: 24px; }

.tx-head__copy { min-width: 0; }

.tx-head__title {
  margin: 0;
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.15;
  color: var(--ta2-text, #101828);
}

.tx-head__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 7px 0 0;
  font-size: 0.82rem;
  color: var(--ta2-muted, #667085);
}

.tx-head__meta strong { font-weight: 700; color: var(--ta2-text, #101828); }

.tx-head__exam { font-weight: 600; color: var(--ta2-text, #101828); }

.tx-dot {
  width: 4px;
  height: 4px;
  flex: none;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.55;
}

.tx-head__right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.tx-date {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 18px 10px 14px;
  border-radius: 14px;
  background: var(--ta2-card, #ffffff);
  border: 1px solid var(--ta2-border, #e6ecf5);
  box-shadow: var(--ta2-shadow, 0 1px 2px rgba(16, 24, 40, 0.04));
}

.tx-date__icon {
  display: grid;
  place-items: center;
  color: var(--ta2-blue, #2563eb);
}

.tx-date__icon svg { width: 20px; height: 20px; }

.tx-date__body { display: flex; flex-direction: column; gap: 1px; }

.tx-date__label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ta2-faint, #98a2b3);
}

.tx-date__value {
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--ta2-text, #101828);
  font-variant-numeric: tabular-nums;
}

.tx-tagline {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding-bottom: 4px;
  font-size: 0.8rem;
  font-style: italic;
  line-height: 1.3;
  color: var(--ta2-muted, #667085);
}

.tx-tagline__line { display: flex; align-items: baseline; gap: 6px; }

.tx-tagline__line em {
  font-style: italic;
  font-weight: 600;
  color: var(--ta2-text, #101828);
}

.tx-tagline__line i {
  font-style: normal;
  font-weight: 800;
  color: #a855f7;
}

.tx-tagline__swoosh {
  width: 100%;
  height: 10px;
  margin-top: 1px;
}

/* ------------------------------ KPI row -------------------------------- */

.tx-kpis {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.tx-kpi {
  display: flex;
  flex-direction: column;
  padding: 16px 18px 14px;
  border-radius: 16px;
  background: var(--ta2-card, #ffffff);
  border: 1px solid var(--ta2-border, #e6ecf5);
  box-shadow: var(--ta2-shadow, 0 1px 2px rgba(16, 24, 40, 0.04));
  animation: score-summary-rise 0.35s ease-out;
}

.tx-kpi__top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tx-kpi__icon {
  width: 44px;
  height: 44px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 14px;
}

.tx-kpi__icon svg { width: 22px; height: 22px; }

.tx-kpi__icon--blue { background: var(--ta2-blue-soft, #eef4ff); color: var(--ta2-blue, #2563eb); }
.tx-kpi__icon--purple { background: var(--ta2-purple-soft, #f3ecff); color: var(--ta2-purple, #7c3aed); }
.tx-kpi__icon--amber { background: var(--ta2-amber-soft, #fef6e7); color: var(--ta2-amber, #b45309); }
.tx-kpi__icon--green { background: var(--ta2-green-soft, #e7f8ef); color: var(--ta2-green, #15803d); }

.tx-kpi__fig {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.tx-kpi__value {
  font-size: 1.45rem;
  font-weight: 800;
  line-height: 1.15;
  color: var(--ta2-text, #101828);
  font-variant-numeric: tabular-nums;
}

.tx-kpi__label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--ta2-muted, #667085);
}

.tx-kpi--warn .tx-kpi__value { color: var(--ta2-amber, #b45309); }

.tx-spark { flex: none; margin-left: auto; }

.tx-kpi__desc {
  margin: 12px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--ta2-border-soft, #eef2f8);
  font-size: 0.78rem;
  line-height: 1.45;
  color: var(--ta2-muted, #667085);
}

/* --------------------------- insight banner ----------------------------- */

.tx-insight {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 15px 18px;
  border-radius: 16px;
  border: 1px solid var(--ta2-blue-line, #c7d7fe);
  background: linear-gradient(
    96deg,
    rgba(124, 58, 237, 0.18) 0%,
    rgba(37, 99, 235, 0.12) 46%,
    rgba(37, 99, 235, 0.04) 100%
  );
  box-shadow: var(--ta2-shadow, 0 1px 2px rgba(16, 24, 40, 0.04));
  animation: score-summary-rise 0.35s ease-out;
}

.tx-insight__icon {
  width: 42px;
  height: 42px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(124, 58, 237, 0.2);
  color: var(--ta2-purple, #7c3aed);
}

.tx-insight__icon svg { width: 21px; height: 21px; }

.tx-insight__body { flex: 1; min-width: 0; }

.tx-insight__title {
  display: block;
  font-size: 0.86rem;
  font-weight: 800;
  letter-spacing: 0.01em;
  color: var(--ta2-purple, #7c3aed);
}

.tx-insight__text {
  margin: 4px 0 0;
  font-size: 0.87rem;
  line-height: 1.55;
  color: var(--ta2-text, #101828);
}

.tx-insight__text strong { color: var(--ta2-blue, #2563eb); }

.tx-insight__btn {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 16px;
  border-radius: 999px;
  border: 1px solid var(--ta2-blue-line, #c7d7fe);
  background: var(--ta2-blue-soft, #eef4ff);
  color: var(--ta2-blue, #2563eb);
  font-size: 0.8rem;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.tx-insight__btn svg { width: 16px; height: 16px; }

.tx-insight__btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
}

/* -------------------------- table + distribution ------------------------ */

.tx-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

.tx-panel {
  padding: 18px;
  border-radius: 16px;
  background: var(--ta2-card, #ffffff);
  border: 1px solid var(--ta2-border, #e6ecf5);
  box-shadow: var(--ta2-shadow, 0 1px 2px rgba(16, 24, 40, 0.04));
  animation: score-summary-rise 0.35s ease-out;
}

.tx-panel--flash { animation: tx-panel-flash 1.5s ease-out; }

@keyframes tx-panel-flash {
  0% { box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.55); }
  60% { box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.35); }
  100% { box-shadow: var(--ta2-shadow, 0 1px 2px rgba(16, 24, 40, 0.04)); }
}

.tx-panel__head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 14px;
}

.tx-panel__icon {
  width: 38px;
  height: 38px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--ta2-blue-soft, #eef4ff);
  color: var(--ta2-blue, #2563eb);
}

.tx-panel__icon svg { width: 19px; height: 19px; }

.tx-panel__title {
  margin: 0;
  font-size: 1rem;
  font-weight: 800;
  color: var(--ta2-text, #101828);
}

.tx-panel__sub {
  margin: 4px 0 0;
  font-size: 0.78rem;
  line-height: 1.45;
  color: var(--ta2-muted, #667085);
}

.tx-table-scroll {
  overflow-x: auto;
  border-radius: 12px;
  border: 1px solid var(--ta2-border-soft, #eef2f8);
}

.tx-table { min-width: 560px; font-size: 0.8rem; }

.tx-table thead th { padding: 10px 9px; font-size: 0.66rem; }

.tx-table tbody td { padding: 11px 9px; }

.tx-table .ta-subject-pill {
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
}

.tx-table .ta-diff-pill { font-size: 0.76rem; font-weight: 700; }

.tx-table .ta-result-pill {
  padding: 4px 10px;
  font-size: 0.64rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.tx-table__empty {
  padding: 26px 12px !important;
  text-align: center;
  color: var(--ta2-muted, #667085);
}

/* pagination */

.tx-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--ta2-border-soft, #eef2f8);
}

.tx-pager__pages {
  display: flex;
  align-items: center;
  gap: 6px;
}

.tx-pager__btn {
  min-width: 32px;
  height: 32px;
  display: inline-grid;
  place-items: center;
  padding: 0 7px;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--ta2-muted, #667085);
  font-size: 0.8rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.tx-pager__btn svg { width: 16px; height: 16px; }

.tx-pager__btn:hover:not(:disabled) {
  background: var(--ta2-card-soft, #f8fafc);
  color: var(--ta2-text, #101828);
}

.tx-pager__btn--active,
.tx-pager__btn--active:hover {
  background: var(--ta2-blue, #2563eb);
  border-color: var(--ta2-blue, #2563eb);
  color: #ffffff;
}

.tx-pager__btn:disabled { opacity: 0.35; cursor: not-allowed; }

.tx-pager__gap {
  padding: 0 2px;
  color: var(--ta2-faint, #98a2b3);
  font-weight: 700;
}

.tx-pager__info {
  font-size: 0.76rem;
  color: var(--ta2-muted, #667085);
  font-variant-numeric: tabular-nums;
}

/* distribution donuts */

.tx-donuts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.tx-donut {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 4px 2px 10px;
  border-right: 1px solid var(--ta2-border-soft, #eef2f8);
}

.tx-donut:last-child { border-right: none; }

.tx-donut .ta-pie__svg {
  width: 100%;
  max-width: 132px;
  height: auto;
  aspect-ratio: 1 / 1;
}

.ta-pie--compact .ta-pie__center-value { font-size: 15px; }
.ta-pie--compact .ta-pie__center-label { font-size: 9.5px; }

.tx-legend {
  list-style: none;
  margin: 10px 0 0;
  padding: 0;
  width: 100%;
}

.tx-legend__row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 2px;
  font-size: 0.7rem;
  color: var(--ta2-text, #101828);
}

.tx-legend__dot { width: 8px; height: 8px; flex: none; border-radius: 50%; }

.tx-legend__label {
  min-width: 0;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tx-legend__stats {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.tx-legend__pct { font-weight: 800; color: var(--ta2-blue, #2563eb); }
.tx-legend__count { font-weight: 600; color: var(--ta2-faint, #98a2b3); }
.tx-legend__time { font-weight: 700; color: var(--ta2-text, #101828); }

.tx-donut__caption {
  margin: 8px 0 0;
  font-size: 0.7rem;
  line-height: 1.4;
  text-align: center;
  color: var(--ta2-muted, #667085);
}

/* tip strip */

.tx-tip {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-top: 16px;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid var(--ta2-blue-line, #c7d7fe);
  background: var(--ta2-blue-soft, #eef4ff);
}

.tx-tip__icon {
  width: 30px;
  height: 30px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.16);
  color: var(--ta2-blue, #2563eb);
}

.tx-tip__icon svg { width: 16px; height: 16px; }

.tx-tip__body { flex: 1; min-width: 0; }

.tx-tip__text {
  margin: 0;
  font-size: 0.78rem;
  line-height: 1.5;
  color: var(--ta2-text, #101828);
}

.tx-tip__text strong { color: var(--ta2-blue, #2563eb); }

.tx-tip__list {
  list-style: none;
  margin: 10px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.tx-tip__list li {
  position: relative;
  padding-left: 15px;
  font-size: 0.75rem;
  line-height: 1.45;
  color: var(--ta2-muted, #667085);
}

.tx-tip__list li::before {
  content: '';
  position: absolute;
  left: 3px;
  top: 6px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--ta2-blue, #2563eb);
}

.tx-tip__toggle {
  width: 30px;
  height: 30px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 1px solid transparent;
  background: transparent;
  color: var(--ta2-blue, #2563eb);
  cursor: pointer;
}

.tx-tip__toggle:hover { background: rgba(37, 99, 235, 0.12); }

.tx-tip__toggle svg {
  width: 17px;
  height: 17px;
  transition: transform 0.2s ease;
}

.tx-tip__toggle[aria-expanded='true'] svg { transform: rotate(90deg); }

/* ------------------------------ responsive ------------------------------ */

@media (max-width: 1100px) {
  .tx-grid { grid-template-columns: minmax(0, 1fr); }
  .tx-donut .ta-pie__svg { max-width: 160px; }
}

@media (max-width: 900px) {
  .tx-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tx-head__title { font-size: 1.55rem; }
}

@media (max-width: 700px) {
  .tx-head { align-items: flex-start; }
  .tx-head__right { width: 100%; justify-content: space-between; gap: 12px; }
  .tx-insight { flex-wrap: wrap; }
  .tx-insight__btn { margin-left: 56px; }
}

@media (max-width: 560px) {
  .tx-kpis { grid-template-columns: minmax(0, 1fr); }
  .tx-donuts { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .tx-donut { border-right: none; border-bottom: 1px solid var(--ta2-border-soft, #eef2f8); }
  .tx-donut:last-child { border-bottom: none; }
  .tx-donut .ta-pie__svg { max-width: 172px; }
  .tx-pager { justify-content: center; }
  .tx-insight__btn { margin-left: 0; }
}

@media print {
  .tx-insight__btn, .tx-tip__toggle, .tx-pager { display: none !important; }
  .tx-panel, .tx-kpi, .tx-insight { box-shadow: none; }
}
