/* ==========================================================================
   MY HISTORY v2 - mock test cards on the LEFT, that test's attempts on the
   RIGHT. Appended block: overrides / additions for the swapped panes.
   ========================================================================== */

/* --------------------------- pane widths --------------------------------- */

.hsh-pane--tests {
  flex: 0.78 1 360px;
  min-width: 330px;
}

.hsh-pane--attempts {
  flex: 1.22 1 460px;
}

/* ------------------------ left pane: mock test cards ---------------------- */

.hsh-pickhead__title {
  margin: 0;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--hp-text);
}

.hsh-pickhead p { margin-top: 5px; }

.hsh-pickgrid {
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
}

.hsh-pick {
  gap: 8px;
  padding: 12px 13px 13px;
  border-radius: 16px;
}

.hsh-pick__title { font-size: 14px; -webkit-line-clamp: 3; }

.hsh-pick__count {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #e6efff;
  color: #245ba8;
  font-size: 10.5px;
  font-weight: 800;
  padding: 4px 9px;
  border-radius: 999px;
  white-space: nowrap;
}
body.dark .hsh-pick__count { background: #23304a; color: #9ec1f5; }

/* the count already owns the auto margin, keep the tick right next to it */
.hsh-pick__top .hsh-pick__check { margin-left: 0; }

.hsh-pick__cta--none { color: var(--hp-soft); font-weight: 600; }
.hsh-pick:hover .hsh-pick__cta--none svg { transform: none; }

.hsh-skel--card { height: 172px; border-radius: 16px; }

.hsh-count {
  margin: 0;
  padding: 2px 0 4px;
  text-align: center;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--hp-soft);
}

/* ---------------------- right pane: attempt analysis ---------------------- */

.hsh-bar__label {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 14px;
  font-weight: 800;
  color: var(--hp-text);
}
.hsh-bar__label svg { color: #2f6fe4; }

.hsh-attempts-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 2px 2px 0;
}

.hsh-attempts-head__txt { flex: 1; min-width: 0; }

.hsh-attempts-head h2 {
  margin: 0;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--hp-text);
}

.hsh-attempts-head p {
  margin: 7px 0 0;
  font-size: 13.5px;
  color: var(--hp-soft);
  line-height: 1.5;
}

.hsh-attempts-head .hsh-tag {
  margin-top: 4px;
  background: #e6efff;
  color: #245ba8;
}
body.dark .hsh-attempts-head .hsh-tag { background: #23304a; color: #9ec1f5; }

/* attempt cards read a bit wider here, one card per attempt */
.hsh-pane--attempts .hsh-attempt { border-radius: 18px; }

/* ------------------------------ responsive ------------------------------- */

@media (max-width: 1400px) {
  .hsh-pane--tests { flex: 0.9 1 320px; min-width: 300px; }
}

@media (max-width: 1100px) {
  .hsh-pane--tests,
  .hsh-pane--attempts {
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
  }
}

@media (max-width: 700px) {
  .hsh-pickgrid { grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); }
  .hsh-pickhead__title { font-size: 20px; }
  .hsh-attempts-head h2 { font-size: 19px; }
}
